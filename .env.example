# Thermos AI — server-side secrets
# Copy to .env and fill in real values. NEVER commit .env to git.

# FortyGuard Temperature API key (https://fortyguard.com)
FORTYGUARD_API_KEY=your_fortyguard_api_key_here

# NVIDIA NIM API key (https://build.nvidia.com) — starts with nvapi-
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# Proxy server port
PORT=8787

# ── OmniRoute Gateway (https://github.com/diegosouzapw/OmniRoute) ──
# One endpoint, 350 providers (90+ free), auto-fallback, RTK+Caveman compression.
# Thermos will try OmniRoute first, then fall back to direct NVIDIA NIM.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_ENABLED=true
# Optional: if OmniRoute has auth enabled, set its API key here. Leave empty for keyless `auto` mode.
OMNIROUTE_API_KEY=

# ── Frontend (Vite) ──
# Model to use for the agentic swarm. `auto` = OmniRoute picks best free available (zero-config).
# Examples: auto | nvidia/nemotron-3-ultra-550b-a55b | openai/gpt-4o-mini | anthropic/claude-sonnet-4 | google/gemini-2.0-flash
# VITE_OMNIROUTE_MODEL=auto
# Optional: override backend URL if not same origin (e.g. http://localhost:8787 for dev)
# VITE_API_BASE=http://localhost:8787

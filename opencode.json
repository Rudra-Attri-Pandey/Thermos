{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-no-key-required"
      },
      "models": {
        "auto": { "name": "Auto (OmniRoute Auto-Combo — Recommended)" },
        "auto:cheap": { "name": "Auto Cheap" },
        "auto:free": { "name": "Auto Free" },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra 550B" },
        "anthropic/claude-sonnet-4": { "name": "Claude Sonnet 4" },
        "openai/gpt-4o-mini": { "name": "GPT-4o mini" },
        "google/gemini-2.0-flash": { "name": "Gemini 2.0 Flash" },
        "deepseek/deepseek-v3": { "name": "DeepSeek V3 (cheap)" }
      }
    }
  },
  "mcp": {
    "slack": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-slack"],
      "environment": {
        "SLACK_BOT_TOKEN": "{env:SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "{env:SLACK_TEAM_ID}"
      }
    }
  },
  "plugin": []
}
